{
  "expo": {
    "name": "MediConnect AI",
    "slug": "mediconnect-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "org.mediconnect.ruralhealth",
      "adaptiveIcon": {
        "backgroundColor": "#f7faf9"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7faf9",
          "imageWidth": 200
        }
      ]
    ]
  }
}